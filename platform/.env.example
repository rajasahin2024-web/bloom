# ─────────────────────────────────────────────────────────────
# Bloom platform — example environment
# Copy to `.env` and adjust. Never commit the real `.env`.
# ─────────────────────────────────────────────────────────────

# PostgreSQL 16 (with pgvector)
POSTGRES_USER=bloom
POSTGRES_PASSWORD=bloom_dev_password
POSTGRES_DB=bloom
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# PgBouncer (connection pooler in front of Postgres)
PGBOUNCER_HOST=pgbouncer
PGBOUNCER_PORT=6432
# transaction | session | statement. App uses transaction pooling.
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=20

# Redis (cache + queue)
REDIS_HOST=redis
REDIS_PORT=6379

# ── App database URLs (for LOCAL dev: uvicorn/vite running on the host) ────
# These use the host-mapped ports from docker-compose.yml:
#   Postgres  -> localhost:5433  (host 5432 is reserved)
#   PgBouncer -> localhost:6432
#   Redis     -> localhost:6380  (host 6379 is reserved)
# When the API runs inside Docker, docker-compose.yml overrides these with
# the docker-internal hostnames (pgbouncer:6432, postgres:5432, redis:6379).
DATABASE_URL=postgresql+psycopg://bloom:bloom_dev_password@localhost:6432/bloom
DATABASE_URL_DIRECT=postgresql+psycopg://bloom:bloom_dev_password@localhost:5433/bloom
REDIS_URL=redis://localhost:6380/0

# ── API (FastAPI) ────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
# CORS origin for the Vite dev server
WEB_ORIGIN=http://localhost:5173
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Web (Vite) ───────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
