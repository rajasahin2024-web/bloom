# ─────────────────────────────────────────────────────────────
# Bloom platform — example environment
# Copy to `.env` and adjust. Never commit the real `.env`.
# ─────────────────────────────────────────────────────────────

# PostgreSQL 16 (with pgvector)
POSTGRES_USER=bloom
POSTGRES_PASSWORD=bloom_dev_password
POSTGRES_DB=bloom
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Remote-DB deploy: if the api container runs on a different host than the
# database, point these at the DB server's address + its published ports —
# e.g. POSTGRES_HOST=1.2.3.4 / POSTGRES_PORT=5433 / PGBOUNCER_HOST=1.2.3.4.
# Local infra (postgres/pgbouncer/redis services) need not be started then.

# PgBouncer (connection pooler in front of Postgres)
PGBOUNCER_HOST=pgbouncer
PGBOUNCER_PORT=6432
# transaction | session | statement. App uses transaction pooling.
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=20

# Redis (cache + queue)
REDIS_HOST=redis
REDIS_PORT=6379

# ── App database URLs (for LOCAL dev: uvicorn/vite running on the host) ────
# These use the host-mapped ports from docker-compose.yml:
#   Postgres  -> localhost:5433  (host 5432 is reserved)
#   PgBouncer -> localhost:6432
#   Redis     -> localhost:6380  (host 6379 is reserved)
# When the API runs inside Docker, docker-compose.yml overrides these with
# the docker-internal hostnames (pgbouncer:6432, postgres:5432, redis:6379).
DATABASE_URL=postgresql+psycopg://bloom:bloom_dev_password@localhost:6432/bloom
DATABASE_URL_DIRECT=postgresql+psycopg://bloom:bloom_dev_password@localhost:5433/bloom
REDIS_URL=redis://localhost:6380/0

# ── API (FastAPI) ────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# development|test → refresh cookie ships WITHOUT Secure and dev-only
# surfaces arm (OTP echo, dev JWT secret). Production installs must set
# API_ENV=production — the setup wizard's apply writes it automatically, and
# boot logs CRITICAL if SETUP_COMPLETE is true while the env is still dev/test.
API_ENV=development
# CORS origin for the Vite dev server
WEB_ORIGIN=http://localhost:5173
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Auth — CHANGE IN PRODUCTION. Generate with: openssl rand -hex 32
# Guard: with API_ENV outside development/test the API refuses to issue or
# verify JWTs (and logs CRITICAL at boot) while this stays at the default.
JWT_SECRET=dev-only-insecure-secret
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# Login brute-force throttle on POST /api/auth/login — fixed-window Redis
# counters per caller IP and per target email; generic 429 once exceeded.
LOGIN_RATE_LIMIT_IP=20
LOGIN_RATE_LIMIT_EMAIL=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# OTP (phone/email verification). OTP_DEV_ECHO returns the issued code in the
# API response — dev/test only, never enable in production.
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_DEV_ECHO=true

# WAISE WhatsApp alerts (TEC-64). Leave blank to use the logging stub.
WAISE_WEBHOOK_URL=
WAISE_TEAM_NUMBER=
WAISE_WEBHOOK_TIMEOUT_SECONDS=5

# ── Mail provisioning (TEC-184) ─────────────────────────────
# Stalwart contract client for student mailboxes on MAIL_DOMAIN. Token comes
# from the secrets store — never commit a real one. Leave MAIL_API_URL blank
# to run the null adapter (signups still succeed; mailboxes stay queued).
# Stalwart's loopback-bound admin listener is reachable inside the deploy
# compose network as http://stalwart:8080, but the adapter enforces HTTPS for
# non-loopback hosts — use the verified public JMAP endpoint instead:
#   MAIL_API_URL=https://mailengine.bloomieltsacademy.com
MAIL_API_URL=
MAIL_API_TOKEN=
MAIL_API_TIMEOUT_SECONDS=5
MAIL_DOMAIN=bloomieltsacademy.com
MAIL_DEFAULT_QUOTA_MB=1024
MAIL_USERNAME_CHECK_LIMIT=30
MAIL_USERNAME_CHECK_WINDOW_SECONDS=300
MAIL_PROVISION_MAX_ATTEMPTS=8
MAIL_PROVISION_BASE_DELAY_SECONDS=30

# ── Mail admin surface (TEC-188) ────────────────────────────
# Host the admin probes dial (SMTP/IMAP/TLS + DNS expectations) — the MX
# host, not necessarily the management-API host.
MAIL_SERVICE_HOST=mail.bloomieltsacademy.com
# Service account for POST /api/admin/mail/test-send (DevOps, TEC-190).
# Until both are set the endpoint reports `unavailable`.
MAIL_TEST_ADDRESS=
MAIL_TEST_SECRET=
# DoH resolver for GET /api/admin/mail/dns (dns-json format).
MAIL_DOH_URL=https://1.1.1.1/dns-query
MAIL_PROBE_TIMEOUT_SECONDS=10
MAIL_ADMIN_PROBE_LIMIT=10
MAIL_ADMIN_PROBE_WINDOW_SECONDS=60

# ── First-run setup ──────────────────────────────────────────
# Written by the setup wizard's apply step (/api/setup/*). Once true, all
# /api/setup/* endpoints refuse with 410. Leave unset/false for dev.
SETUP_COMPLETE=false
# Optional: point the app at a different env file than platform/.env.
# BLOOM_ENV_FILE=/path/to/.env


# ── Institute identity (core settings) ──────────────────────
# Written by the IELTS installer wizard at apply; editable later from admin
# settings. INSTITUTE_LOGO_URL points at the uploaded logo served by the API.
INSTITUTE_NAME=
INSTITUTE_TAGLINE=
INSTITUTE_LOGO_URL=

# ── Web (Vite) ───────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
