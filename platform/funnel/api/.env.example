# --- Payment rail ---
# "mock" auto-settles via /mock-settle (no keys needed — default for dev/QA).
# "razorpay" requires the three RAZORPAY_* vars below.
PAYMENT_RAIL=mock

# Razorpay (arrive via TEC-112; test keys are rzp_test_*)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Set to 1 when using rzp_test_* keys (informational; signature check identical)
RAZORPAY_X_RAZORPAY_TEST=

# --- Meta Conversions API ---
META_PIXEL_ID=
META_CAPI_TOKEN=
# Optional: routes events to Events Manager "Test events" tab
META_TEST_EVENT_CODE=
# Default 1 = log the exact CAPI payload instead of sending. Set 0 once creds exist.
META_CAPI_DRY_RUN=1

# --- Admin / security ---
# Required for GET /api/funnel/buyers.csv
ADMIN_TOKEN=
# HMAC secret for download links. Unset = random per boot (links die on restart).
DOWNLOAD_SIGNING_SECRET=
# Seconds before signed download links expire (default 86400 = 24h)
DOWNLOAD_URL_TTL_SECONDS=86400

# --- Runtime ---
# Absolute base URL used in settle/download links (default: request origin)
FUNNEL_BASE_URL=http://82.112.226.111:8090
# Comma-separated CORS origins (default *)
FUNNEL_CORS_ORIGINS=*
# FUNNEL_DB_PATH=/abs/path/funnel.db
# FUNNEL_ASSETS_DIR=/abs/path/platform/funnel/assets

# --- Gated delivery area (buyer portal) ---
# Buyer session token lifetime (default 30 days)
GATED_SESSION_TTL_SECONDS=2592000
# Where generated certificate PDFs are written
# FUNNEL_CERTIFICATES_DIR=/abs/path/platform/funnel/api/data/certificates
# Optional explicit course manifest (default: {assets}/course/manifest.json,
# falling back to the bundled placeholder app/course_manifest.json)
# FUNNEL_COURSE_MANIFEST=/abs/path/manifest.json
